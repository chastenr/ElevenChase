# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Resend API key used to send contact/audit form notifications.
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Fixed recipient address for contact/audit form submissions.
# This is never taken from user input.
CONTACT_EMAIL_TO=start@elevenchase.com

# Optional "From" address/display name used when sending via Resend.
# Must be a verified sender/domain in your Resend account.
CONTACT_EMAIL_FROM=ElevenChase <start@elevenchase.com>
