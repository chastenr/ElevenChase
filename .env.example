# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Resend API key used to send contact/audit form notifications.
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Fixed recipient address for contact/audit form submissions.
# This is never taken from user input.
CONTACT_EMAIL_TO=start@elevenchase.com

# Optional "From" address/display name used when sending via Resend.
# Must be a verified sender/domain in your Resend account.
CONTACT_EMAIL_FROM=ElevenChase <start@elevenchase.com>

# --- Client Workspace (internal admin) -------------------------------------
# Supabase project backing the internal Client Workspace. Safe to expose to
# the browser: access is still gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. Bypasses Row Level Security entirely — server-only,
# never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
